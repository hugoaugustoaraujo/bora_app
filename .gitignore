# ──────────────────────────────────────────────
# Dependências (cada pessoa roda `npm install`)
# ──────────────────────────────────────────────
node_modules/

# ──────────────────────────────────────────────
# Variáveis de ambiente e segredos
# (use bora-backend/.env.example como modelo)
# ──────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem

# ──────────────────────────────────────────────
# Builds e artefatos de compilação
# ──────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ──────────────────────────────────────────────
# Expo / React Native
# As pastas nativas são geradas por `npx expo prebuild`
# a partir do app.json — não versionar.
# ──────────────────────────────────────────────
.expo/
.expo-shared/
web-build/
android/
ios/
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ──────────────────────────────────────────────
# Android nativo (quando gerado localmente)
# ──────────────────────────────────────────────
.gradle/
local.properties
*.iml
*.hprof
.cxx/
*.jsbundle

# ──────────────────────────────────────────────
# Testes e cobertura
# ──────────────────────────────────────────────
coverage/

# ──────────────────────────────────────────────
# Uploads em runtime (avatares enviados pelo app).
# A imagem padrão continua versionada.
# ──────────────────────────────────────────────
bora-backend/images/*
!bora-backend/images/padrao.png

# ──────────────────────────────────────────────
# Logs e debug
# ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────────
# Sistema operacional e editores
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
